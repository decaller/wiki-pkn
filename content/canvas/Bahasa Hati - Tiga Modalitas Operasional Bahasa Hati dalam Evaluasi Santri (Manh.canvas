    },
    {
      "id": "D1",
      "type": "text",
      "text": "Melayani kemauan, menuruti permintaan wajar,\nmenjaga rahasia, menutupi aib, memaafkan kesalahan",
      "x": -455,
      "y": 348,
      "width": 420,
      "height": 88,
      "color": "1"
    },
    {
      "id": "D2",
      "type": "text",
      "text": "Membela saat terpojok, menghadirkan rasa aman batin,\nmenepis kecemasan, menjadi benteng perlindungan",
      "x": 35,
      "y": 348,
      "width": 420,
      "height": 88,
      "color": "6"
    }
