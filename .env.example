# ==============================================================================
# Wiki PKN (Pendidikan Karakter Nabawiyah) - Environment Configuration Template
# ==============================================================================
# Petunjuk: Salin berkas ini ke '.env' dan isi nilai-nilai rahasia sesuai lingkungan.
#   cp .env.example .env
# DILARANG meng-commit file '.env' ke repository publik!
# Kredensial Git disimpan global di ~/.git-credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DOMAIN & WEB RUNTIME (QUARTZ / NGINX)
# ------------------------------------------------------------------------------
DOMAIN=wikipkn.insanmustaqbal.or.id
BASE_URL=wikipkn.insanmustaqbal.or.id
QUARTZ_BASE_URL=wikipkn.insanmustaqbal.or.id
PRODUCTION_URL=https://wikipkn.insanmustaqbal.or.id

# Port internal Nginx container (default: 8080)
PORT=8080

# Port host produksi (VPS reverse proxy / Zoraxy meneruskan port 4040 -> 8080)
HOST_PORT=4040

# Rekomendasi port host lokal jika menjalankan Docker di PC lokal (mencegah bentrok dengan api-tb40)
LOCAL_HOST_PORT=4045

# WebSocket Hot-Reload untuk pengembangan lokal ('npx quartz build --serve')
WS_PORT=3001

# ------------------------------------------------------------------------------
# 2. GITHUB REPOSITORY & REGISTRY (GHCR)
# ------------------------------------------------------------------------------
GITHUB_REPOSITORY=decaller/wiki-pkn
GITHUB_URL=https://github.com/decaller/wiki-pkn
GHCR_REGISTRY=ghcr.io
GHCR_IMAGE=ghcr.io/decaller/wiki-pkn:latest

# ------------------------------------------------------------------------------
# 3. PORTAINER GITOPS & AUTO-REDEPLOY WEBHOOK
# ------------------------------------------------------------------------------
PORTAINER_URL=https://portainer.insanmustaqbal.or.id
PORTAINER_HOST_IP=103.167.12.129
PORTAINER_ENDPOINT_ID=3
PORTAINER_STACK_ID=25
PORTAINER_STACK_NAME=wiki-pkn
PORTAINER_WEBHOOK_UUID=your-portainer-webhook-uuid-here
PORTAINER_WEBHOOK_URL=https://portainer.insanmustaqbal.or.id/api/stacks/webhooks/your-portainer-webhook-uuid-here

# ------------------------------------------------------------------------------
# 4. ANALYTICS & COMMUNITY INTERACTION (UMAMI & GISCUS)
# ------------------------------------------------------------------------------
# Umami Analytics (Self-hosted di Portainer Stack 27, Endpoint 3)
UMAMI_HOST=https://analytics.insanmustaqbal.or.id
UMAMI_PORT=3008
UMAMI_WEBSITE_ID=your-umami-website-uuid
UMAMI_DB_USER=umami
UMAMI_DB_PASSWORD=your-secure-db-password
UMAMI_APP_SECRET=your-random-app-secret-key

# Giscus (Komentar GitHub Discussions)
GISCUS_REPO=decaller/wiki-pkn
GISCUS_REPO_ID=
GISCUS_CATEGORY=General
GISCUS_CATEGORY_ID=

# ------------------------------------------------------------------------------
# 5. OPENBAYAN & QDRANT SEMANTIC SEARCH CLUSTER
# ------------------------------------------------------------------------------
QDRANT_HOST=http://localhost:6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=shamela_11m
SHAMELA_DB_PATH=/home/abuhafi/Project/OpenBayanNext/data/shamela_corpus.db

# ------------------------------------------------------------------------------
# 6. TB-40 TALENT ASSESSMENT & RAPOR KARAKTER ECOSYSTEM
# ------------------------------------------------------------------------------
TB40_PROXY_PORT=3030
TB40_API_URL=http://localhost:4040
POCKETBASE_URL=http://localhost:8090
RAPOR_DB_HOST=localhost
RAPOR_DB_PORT=5432
RAPOR_DB_NAME=rapor_karakter

# ------------------------------------------------------------------------------
# 7. UNSTRUCTURED API (MULTIMODAL EXTRACTION)
# ------------------------------------------------------------------------------
UNSTRUCTURED_HOST_PORT=8005
UNSTRUCTURED_API_URL=http://localhost:8005/general/v0/general
UNSTRUCTURED_API_KEY=
