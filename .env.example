# ==========================================
# Wiki PKN - Environment Variables
# ==========================================

# Domain name used for canonical URLs, sitemaps, and OpenGraph metadata.
# Can include or omit protocol (e.g., wiki.example.com or https://wiki.example.com)
DOMAIN=localhost:8080

# Web server port inside and outside the container (default: 8080)
PORT=8080

# Host port override (optional: if you want the host port to differ from container port)
# e.g., to expose on host port 80 while container runs on 8080:
# HOST_PORT=80

# WebSocket hot-reload port (default: 3001)
WS_PORT=3001
