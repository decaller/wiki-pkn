# ==========================================
# Wiki PKN - Environment Variables
# ==========================================

# Base URL & Domain name used for canonical URLs, sitemaps, and OpenGraph metadata
DOMAIN=wikipkn.insanmustaqbal.or.id
BASE_URL=wikipkn.insanmustaqbal.or.id
QUARTZ_BASE_URL=wikipkn.insanmustaqbal.or.id

# Web server port inside and outside the container (default: 8080)
PORT=8080

# WebSocket hot-reload port (default: 3001)
WS_PORT=3001

# Giscus Comments (GitHub Discussions)
GISCUS_REPO=decaller/wiki-pkn
GISCUS_REPO_ID=
GISCUS_CATEGORY=General
GISCUS_CATEGORY_ID=
